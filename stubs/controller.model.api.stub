<?php

namespace {{ namespace }};

use {{ namespacedModel }};
use {{ rootNamespace }}Http\Controllers\Controller;
use {{ namespacedRequests }}
use Illuminate\Http\JsonResponse;

class {{ class }} extends Controller
{
    /**
     * Display a listing of the resource.
     */
    public function index(): JsonResponse
    {
        $data = new {{ model }}()->get{{model}}s();

        return response()->json([
            'message' => "{{ model }} list retrieved successfully.",
            'data' => $data,
        ]);
    }

    /**
     * Store a newly created resource in storage.
     */
    public function store({{ storeRequest }} $request): JsonResponse
    {
        $data = {{ model }}::create($request->validated());

        return response()->json([
            'message' => "{{ model }} created successfully.",
            'data' => $data,
        ], 201);
    }

    /**
     * Display the specified resource.
     */
    public function show(int ${{ modelVariable }}Id): JsonResponse
    {
        $data = new {{ model }}()->find{{ model }}(${{ modelVariable }}Id);

        if (empty($data)) {
            return response()->json(['message' => "No {{ model }} found."], 400);
        }
        
        return response()->json([
            'message' => "{{ model }} retrieved successfully.",
            'data' => $data,
        ]);
    }

    /**
     * Update the specified resource in storage.
     */
    public function update({{ updateRequest }} $request, int ${{ modelVariable }}Id): JsonResponse
    {
        ${{ modelVariable }}Obj = new {{ model }}()->find{{ model }}(${{ modelVariable }}Id);

        if (empty(${{ modelVariable }}Obj)) {
            return response()->json(['message' => "No {{ model }} found."], 400);
        }

        ${{ modelVariable }}Obj->update($request->validated());

        
        return response()->json([
            'message' => "{{ model }} updated successfully.",
            'data' => ${{ modelVariable }}Obj->fresh(),
        ]);
    }

    /**
     * Remove the specified resource from storage.
     */
    public function destroy(int ${{ modelVariable }}Id): JsonResponse
    {
        
        ${{ modelVariable }}Obj = new {{ model }}()->find{{ model }}(${{ modelVariable }}Id);

        if (empty(${{ modelVariable }}Obj)) {
            return response()->json(['message' => "No {{ model }} found."], 400);
        }
        ${{ modelVariable }}Obj->delete();

        return response()->json([
            'message' => "{{ model }} deleted successfully.",
        ]);
    }
}
